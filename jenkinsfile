pipeline {
    agent any 

    stages {
        stage('Clone Repository') {
            steps {
                git url: 'https://github.com/IlmaNabila41/KADA-Backend.git', branch: 'main'
            }
        }

        stage('Inject ENV') {
            steps {
                // Pastikan credentialsId 'env-file' sudah dibuat di Jenkins Dashboard
                withCredentials([file(credentialsId: 'env-file', variable: 'ENV_FILE')]) {
                    script {
                        // Gunakan /Y agar otomatis overwrite jika file .env sudah ada
                        bat "copy /Y %ENV_FILE% .env"
                    }
                }
            }
        }

        stage('Build Docker') {
            steps {
                bat 'docker build -t kada-backend-app .'
            }
        }

        stage('Deploy') {
            steps {
                script {
                    try {
                        // Menghentikan dan menghapus container lama jika ada
                        bat "docker stop kada-backend-container"
                        bat "docker rm -f kada-backend-container"
                    } catch (Exception e) {
                        echo "Container belum ada atau sudah berhenti, langsung deploy baru..."
                    }

                    // Perhatikan: pastikan port 3000 tidak dipakai aplikasi lain di Windows
                    bat "docker run -d -p 3000:3000 --name kada-backend-container --env-file .env kada-backend-app"
                }
            }
        }
    }
    
    post {
        always {
            echo "Status container saat ini:"
            bat 'docker ps -a'
        }
    }
}
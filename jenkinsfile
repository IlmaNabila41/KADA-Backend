pipeline {
    agent any 

    stages {
        
        stage('Clone Repository') {
            steps {
                // Perbaikan sintaks git
                git url: 'https://github.com/IlmaNabila41/KADA-Backend.git', branch: 'main'
            }
        }

        stage('Inject ENV') {
            steps {
                withCredentials([file(credentialsId: 'env-file', variable: 'ENV_FILE')]) {
                    script {
                        // Salin file credentials ke .env proyek
                        bat "copy %ENV_FILE% .env"
                        // bat "chmod 600 .env"
                    }
                }
            }
        }

        stage('Build Docker') {
            steps {
                // Menambahkan tag nama image dan lokasi Dockerfile (.)
                bat 'docker build -t kada-backend-app .'
            }
        }

        stage('Deploy') {
            steps {
                script {
try {
                bat "docker stop kada-backend-container"
                bat "docker rm kada-backend-container"
            } catch (Exception e) {
                echo "Container belum ada, lanjut ke tahap run..."
            }

// Jalankan container baru dengan file .env yang sudah di-inject
                bat "docker run -d -p 8080:8080 --name kada-backend-container --env-file .env kada-backend-app"
                }
            }
        }
    }
    
    post {
        always {
            bat 'docker ps -a'
        }
    }
}